# Copy to .env and set SESSION_SECRET to a fresh 32-byte base64 secret.
# These values are for the direct host development workflow.
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/easygen
SESSION_SECRET=
HOST=127.0.0.1
PORT=3000
TRUSTED_PROXY_CIDRS=

# Private bridge values for `docker compose -f compose.app.yaml up`.
# Change both if the subnet overlaps a route or another Docker network.
DOCKER_APP_SUBNET=172.30.0.0/24
DOCKER_APP_HOST=172.30.0.3
